# WhoNow Environment Configuration
# Copy this file to .env.local and fill in your values

# ==========================
# Supabase Configuration
# ==========================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ==========================
# AI Feature Flags
# ==========================

# Master AI switch - disables all AI features if set to false
VITE_ENABLE_AI=true

# Enable semantic query parsing (T5 model, ~30MB)
# Browser users must still opt-in via settings
VITE_ENABLE_SEMANTIC_PARSING=true

# Enable semantic similarity ranking (embeddings, ~80MB)
# Browser users must still opt-in via settings
VITE_ENABLE_SEMANTIC_RANKING=true

# Enable debug mode for detailed AI logging
# Only enable in development
VITE_AI_DEBUG_MODE=false

# ==========================
# AI Model Configuration
# ==========================

# T5 model for query parsing
# Default: Xenova/LaMini-Flan-T5-77M (~30MB)
VITE_LLM_MODEL=Xenova/LaMini-Flan-T5-77M

# Embedding model for semantic similarity
# Default: Xenova/all-MiniLM-L6-v2 (~80MB)
VITE_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# Model storage URL for browser/PWA users
# Should point to Supabase Storage bucket where models are hosted
# Example: https://your-project.supabase.co/storage/v1/object/public/ai-models
VITE_MODEL_STORAGE_URL=

# AI timeout in milliseconds (default: 5000)
VITE_AI_TIMEOUT_MS=5000

# ==========================
# App Configuration
# ==========================
#
# Where to set production URL (https://whonow.co):
#   1. Google Cloud Console – OAuth client: Authorized JavaScript origins + Redirect URIs (see Google Contacts section below).
#   2. Supabase Dashboard → Authentication → URL Configuration: Site URL + Redirect URLs (e.g. https://whonow.co/auth).
#   3. Supabase Dashboard → Edge Functions → Secrets: APP_URL = https://whonow.co (Slack/Teams OAuth redirect back).
#   4. Production build (Vercel/Netlify/GitHub Actions): set VITE_APP_URL=https://whonow.co if you need it for desktop app email links.
#
# Public web app URL. When running in the desktop (Tauri) app, this is used for
# email verification and password-reset links so users land on a real web page
# instead of a blank tauri:// URL. Set to your deployed site.
# Also set in your production build (e.g. Vercel/Netlify env or GitHub Actions).
# VITE_APP_URL=https://whonow.co

# ==========================
# Desktop app download URLs (landing page)
# ==========================
# Option A: Set VITE_GITHUB_REPO and VITE_GITHUB_RELEASES_ENABLED=true so the Download
# section fetches the latest GitHub release. Only set RELEASES_ENABLED when you have
# at least one release published (avoids 404 in console). No redeploy when you push a new release.
# VITE_GITHUB_REPO=owner/repo
# VITE_GITHUB_RELEASES_ENABLED=true

# Option B: Fallback / override. If VITE_GITHUB_REPO is unset or a platform has no asset,
# these env vars are used. Also used for iOS/Android (App Store / Play Store links).
# VITE_DOWNLOAD_URL_WINDOWS=https://github.com/OWNER/REPO/releases/download/v1.0.0/WhoNow_1.0.0_x64_en-US.msi
# VITE_DOWNLOAD_URL_MAC=https://github.com/OWNER/REPO/releases/download/v1.0.0/WhoNow_1.0.0_x64.dmg
# VITE_DOWNLOAD_URL_LINUX=https://...

# ==========================
# Google Contacts (OAuth)
# ==========================
# Create an OAuth 2.0 Client ID (Web application) in Google Cloud Console.
# To fix "Error 400: redirect_uri_mismatch", add these in your OAuth client:
#
#   Authorized JavaScript origins:
#     http://localhost:5173          (Vite dev)
#     https://whonow.co              (production)
#     https://www.whonow.co          (if you use www)
#
#   Authorized redirect URIs (include both with and without trailing slash):
#     http://localhost:5173/
#     http://localhost:5173
#     https://whonow.co/
#     https://whonow.co
#     https://www.whonow.co/
#     https://www.whonow.co
#
# VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# ==========================
# Meta (Facebook) Pixel
# ==========================
# Optional. Your Meta Pixel ID for tracking free trial sign-ups (StartTrial event).
# Get it from Meta Events Manager → Data Sources → your pixel.
# VITE_META_PIXEL_ID=123456789012345
